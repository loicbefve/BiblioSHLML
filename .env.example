# Examples of needed env variables
# To set your variables in DEV environment you can rename this file .env.development and adjust the env variable
# For production it is the same but with .env.production

# URL de base de l'API.
#
# En production, nginx expose l'API sur la MEME origine que le front,
# sous le prefixe /api (voir docs/nginx.conf.example). On utilise donc un chemin
# relatif : le navigateur reprend automatiquement le scheme et le domaine de la
# page, ce qui evite tout blocage "mixed content" en HTTPS et supprime le CORS.
#   VITE_API_URL=/api
#
# En developpement local, l'API tourne sur son propre port, sans proxy :
VITE_API_URL=http://localhost:8000
